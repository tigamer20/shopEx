# ShopEx API configuration (ARCHITECTURE.md section 6).
# Copy this file to .env for local development. Never commit a real .env file.
# Empty values are treated as "not set" and fall back to the defaults below.

# "development" or "production". Production enables strict checks (JWT_SECRET required).
ENV=development

# SQLAlchemy database URL. SQLite for local development.
# Production uses Neon Postgres: in the Render dashboard (never in this file or in Git), set the
# Neon pooled connection string, shaped like
#   postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# postgres:// and postgresql:// are normalised to postgresql+psycopg:// (query string kept).
DATABASE_URL=sqlite:///./shopex.db

# Secret used to sign access tokens (HS256). Required in production, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty in development to get a random per-process secret (tokens reset on restart).
JWT_SECRET=

# Access token lifetime in minutes (10080 = 7 days).
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Shared secret for POST /api/v1/admin/refresh (sent in the X-Admin-Token header).
# Leave empty to disable the endpoint (it then answers 404). Must be at least 32 characters
# when ENV=production.
ADMIN_TOKEN=

# Overpass API endpoint used to discover grocery stores (OpenStreetMap data, ODbL).
OVERPASS_URL=https://overpass-api.de/api/interpreter

# OSRM routing server. The public demo server is for development only.
OSRM_URL=https://router.project-osrm.org

# Timeout in seconds for outbound HTTP calls to OSRM.
HTTP_TIMEOUT_S=20

# Overpass query timeout in seconds (the public server often needs 20-45 s for a city).
OVERPASS_TIMEOUT_S=45

# Largest search radius accepted from clients, in kilometres.
MAX_RADIUS_KM=50

# Nearest N stores kept per area discovery.
MAX_STORES_PER_AREA=60

# Price source registry key (see app/services/price_sources).
PRICE_SOURCE=demo

# Synthesise clearly-labelled demo stores when Overpass is unreachable.
# Leave empty for the default: true in development, false in production.
DEMO_STORES_FALLBACK=

# Run the daily refresh loop inside the API process every 24 hours.
DAILY_REFRESH_IN_PROCESS=false
