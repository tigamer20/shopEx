# Copy to `.env` (git-ignored). EXPO_PUBLIC_* values are embedded in the app bundle:
# never put secrets here.

# Base URL of the ShopEx API, without the /api/v1 suffix.
# A value without a scheme (e.g. "shopex-api.onrender.com") gets https:// prepended.
# Android emulator: use http://10.0.2.2:8000 to reach an API running on the host machine.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Map tile URL template used by the itinerary map (Leaflet).
# Keep the "© OpenStreetMap contributors" attribution visible when using OSM tiles.
EXPO_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
