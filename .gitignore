# ShopEx — files that must never be committed.
# Secrets live in environment variables only; commit the *.example templates instead.

# --- Secrets & local environment ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
# Local EAS credentials and Google Play service-account keys
credentials.json
google-play-service-account*.json

# --- OS & editor files -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace
# Personal AI-assistant settings (shared settings, if any, live in .claude/settings.json)
.claude/settings.local.json

# --- Python (backend) ------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local databases (SQLite in development)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Test coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/

# --- Node / Expo (client) --------------------------------------------------
node_modules/
.expo/
.metro-health-check*
expo-env.d.ts
web-build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Native projects are generated by `npx expo prebuild` / EAS Build (Continuous Native Generation)
client/ios/
client/android/

# --- Build artefacts ---------------------------------------------------------
dist/
build/
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip
.neon
